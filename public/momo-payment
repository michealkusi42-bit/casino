<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Foretell | MoMo Payment</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green: #00a651;
      --green-light: #e6f7ed;
      --green-dark: #007a3d;
      --blue: #1a3c6e;
      --yellow: #f5a623;
      --bg: #f0f2f5;
      --white: #ffffff;
      --border: #e2e6ea;
      --text: #1a1d23;
      --muted: #6b7280;
      --muted2: #9ca3af;
      --danger: #e53935;
      --radius: 14px;
      --radius-sm: 10px;
      --shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 40px;
    }

    /* HEADER */
    .header {
      width: 100%;
      background: var(--blue);
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .header-logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .header-logo-box {
      width: 120px;
      height: 36px;
      background: rgba(255,255,255,0.15);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: 800;
      color: #fff;
      letter-spacing: -0.5px;
      /* Replace background with: background: url('your-logo.png') center/contain no-repeat; */
    }

    /* CONTAINER */
    .container {
      width: 100%;
      max-width: 480px;
      padding: 20px 14px 40px;
    }

    /* CARD */
    .card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 20px;
      margin-bottom: 14px;
      box-shadow: var(--shadow);
    }

    /* SECTION HEADER */
    .sec-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    .sec-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--blue);
    }
    .timer-badge {
      background: #e8f0fe;
      color: #1a3c6e;
      font-size: 13px;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 20px;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.5px;
      transition: background 0.3s, color 0.3s;
    }
    .timer-badge.urgent { background: #fde8e8; color: var(--danger); }
    .timer-badge.loading { color: var(--muted2); background: #f3f4f6; }

    /* NETWORK SELECT */
    .net-option {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      border: 2px solid var(--border);
      border-radius: var(--radius-sm);
      margin-bottom: 10px;
      cursor: pointer;
      transition: all 0.2s;
      background: var(--white);
    }
    .net-option:last-child { margin-bottom: 0; }
    .net-option:hover:not(.disabled) { border-color: var(--green); background: var(--green-light); }
    .net-option.selected { border-color: var(--green); background: var(--green-light); }
    .net-option.disabled { opacity: 0.35; cursor: default; }
    .net-logo {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #f3f4f6;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }
    .net-logo img { width: 100%; height: 100%; object-fit: cover; display: none; }
    /* MTN colors */
    .mtn-bg { background: #ffcc00; }
    .mtn-text { font-size: 9px; font-weight: 800; color: #000; text-align: center; line-height: 1.2; }
    /* Telecel colors */
    .tcl-bg { background: #e3001b; }
    .tcl-text { font-size: 9px; font-weight: 800; color: #fff; text-align: center; line-height: 1.2; }
    /* AirtelTigo colors */
    .at-bg { background: #ef3e23; }
    .at-text { font-size: 9px; font-weight: 800; color: #fff; text-align: center; line-height: 1.2; }

    .net-label { font-size: 15px; font-weight: 600; color: var(--text); }
    .net-check {
      margin-left: auto;
      width: 22px; height: 22px; border-radius: 50%;
      background: var(--green);
      display: none; align-items: center; justify-content: center;
    }
    .net-option.selected .net-check { display: flex; }

    /* NUMBER INPUT (screen 1 bottom) */
    .phone-input-label { font-size: 14px; font-weight: 600; color: var(--text); margin: 16px 0 8px; text-align: center; }
    .phone-input {
      width: 100%;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 13px 16px;
      font-size: 16px; font-weight: 600;
      color: var(--text);
      font-family: 'Inter', sans-serif;
      outline: none; transition: border-color 0.2s;
      text-align: center; letter-spacing: 1px;
    }
    .phone-input::placeholder { color: var(--muted2); font-weight: 400; letter-spacing: 0; }
    .phone-input:focus { border-color: var(--green); }

    /* EMAIL INPUT */
    .field {
      width: 100%;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 13px 16px;
      font-size: 14px; font-weight: 500;
      color: var(--text);
      font-family: 'Inter', sans-serif;
      outline: none; transition: border-color 0.2s;
      background: var(--white);
    }
    .field::placeholder { color: var(--muted2); }
    .field:focus { border-color: var(--green); }
    .field-label { font-size: 13px; font-weight: 600; color: var(--muted); margin-bottom: 7px; display: block; }
    .field-hint { font-size: 11px; color: var(--muted2); margin-top: 5px; }

    /* AMOUNT PRESETS */
    .presets { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin: 14px 0; }
    .preset {
      background: var(--bg); border: 1.5px solid var(--border);
      color: var(--muted); border-radius: 8px; padding: 9px 4px;
      font-size: 12px; font-weight: 600; cursor: pointer;
      font-family: 'Inter', sans-serif; transition: all 0.2s;
    }
    .preset:hover { border-color: var(--green); color: var(--green); background: var(--green-light); }
    .amount-big-input {
      width: 100%; background: var(--bg);
      border: 2px solid var(--border); border-radius: var(--radius-sm);
      padding: 14px; font-size: 30px; font-weight: 800;
      color: var(--green); font-family: 'Inter', sans-serif;
      outline: none; text-align: center; letter-spacing: 1px;
      margin-bottom: 4px;
    }
    .amount-big-input:focus { border-color: var(--green); }

    /* INFO ROWS (account number, name, amount with copy) */
    .info-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 14px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      margin-bottom: 10px;
      background: var(--white);
    }
    .info-row:last-of-type { margin-bottom: 0; }
    .info-icon {
      width: 40px; height: 40px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 10px; font-weight: 800;
    }
    .icon-num { background: #fff3e0; color: #e65100; }
    .icon-name { background: #e3f2fd; color: #1565c0; }
    .icon-amt { background: #e8f5e9; color: #2e7d32; }
    .info-content { flex: 1; }
    .info-label { font-size: 11px; color: var(--muted2); font-weight: 500; margin-bottom: 2px; }
    .info-value { font-size: 15px; font-weight: 700; color: var(--text); }
    .copy-pill {
      background: var(--yellow);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 13px; font-weight: 700;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      flex-shrink: 0;
      transition: background 0.2s;
    }
    .copy-pill:hover { background: #d4880a; }

    /* USSD STEPS */
    .ussd-title {
      font-size: 14px; font-weight: 700; color: var(--blue);
      margin-bottom: 14px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .ussd-step {
      display: flex; gap: 10px; margin-bottom: 9px;
      font-size: 13px; color: var(--muted); align-items: flex-start;
    }
    .ussd-step:last-child { margin-bottom: 0; }
    .ussd-num {
      font-size: 12px; font-weight: 700; color: var(--blue);
      background: #e8f0fe; width: 22px; height: 22px;
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; margin-top: 1px;
    }
    .ussd-text { line-height: 1.5; }
    .ussd-text strong { color: var(--text); }
    .dial-btn {
      width: 100%; margin-top: 16px;
      background: var(--blue); color: #fff;
      border: none; border-radius: var(--radius-sm);
      padding: 14px; font-size: 15px; font-weight: 700;
      cursor: pointer; font-family: 'Inter', sans-serif;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: background 0.2s;
    }
    .dial-btn:hover { background: #0f2a52; }

    /* CONFIRMED PAYMENT BANNER */
    .confirmed-banner {
      background: #e8f5e9;
      border: 2px solid #a5d6a7;
      border-radius: var(--radius-sm);
      padding: 14px 16px;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .confirmed-text { font-size: 14px; font-weight: 700; color: #2e7d32; }
    .confirmed-sub { font-size: 12px; color: #388e3c; margin-top: 3px; }
    .refresh-btn {
      background: var(--blue); color: #fff;
      border: none; border-radius: 8px;
      padding: 8px 14px; font-size: 13px; font-weight: 700;
      cursor: pointer; font-family: 'Inter', sans-serif;
      white-space: nowrap; flex-shrink: 0;
      transition: background 0.2s;
    }
    .refresh-btn:hover { background: #0f2a52; }

    /* SUBMIT SECTION */
    .submit-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 14px; }
    .txn-label { font-size: 13px; font-weight: 600; color: var(--muted); margin-bottom: 8px; }
    .txn-input {
      width: 100%;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 13px 16px;
      font-size: 14px; font-weight: 500;
      color: var(--text);
      font-family: 'Inter', sans-serif;
      outline: none; transition: border-color 0.2s;
      margin-bottom: 14px;
    }
    .txn-input::placeholder { color: var(--muted2); }
    .txn-input:focus { border-color: var(--green); }
    .submit-btn {
      width: 100%; background: var(--blue); color: #fff;
      border: none; border-radius: var(--radius-sm);
      padding: 15px; font-size: 15px; font-weight: 700;
      cursor: pointer; font-family: 'Inter', sans-serif;
      transition: background 0.2s;
    }
    .submit-btn:hover { background: #0f2a52; }

    /* YOUR PHONE NUMBER */
    .phone-row {
      display: flex; align-items: center; gap: 12px;
      padding: 13px 14px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
    }
    .ghana-flag { font-size: 28px; }
    .phone-row-content { flex: 1; }
    .phone-row-label { font-size: 11px; color: var(--muted2); margin-bottom: 2px; }
    .phone-row-val { font-size: 15px; font-weight: 700; color: var(--text); }
    .edit-btn {
      background: var(--yellow); color: #fff;
      border: none; border-radius: 8px;
      padding: 8px 14px; font-size: 13px; font-weight: 700;
      cursor: pointer; font-family: 'Inter', sans-serif;
    }

    /* SECURITY FOOTER */
    .security-note {
      text-align: center;
      font-size: 12px; color: var(--muted);
      padding: 8px 0 0;
    }
    .footer-url {
      text-align: center;
      font-size: 12px; color: var(--muted2);
      padding: 10px 0 0;
      font-weight: 500;
    }

    /* PRIMARY GREEN BUTTON */
    .btn-green {
      width: 100%; background: var(--green); color: #fff;
      border: none; border-radius: var(--radius-sm);
      padding: 15px; font-size: 15px; font-weight: 700;
      cursor: pointer; font-family: 'Inter', sans-serif;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      box-shadow: 0 4px 12px rgba(0,166,81,0.25);
      transition: all 0.2s;
    }
    .btn-green:hover { background: var(--green-dark); }

    /* SUCCESS SCREEN */
    .success-screen { display: none; text-align: center; padding: 20px 0 0; }
    .success-screen.visible { display: block; }
    .success-icon {
      width: 80px; height: 80px; border-radius: 50%;
      background: var(--green-light); border: 2px solid #a5d6a7;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
    }
    .success-title { font-size: 20px; font-weight: 800; color: var(--text); margin-bottom: 8px; }
    .success-sub { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 20px; }
    .detail-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 13px;
    }
    .detail-row:last-child { border-bottom: none; }
    .d-k { color: var(--muted); }
    .d-v { font-weight: 700; color: var(--text); }
    .back-btn {
      width: 100%; background: var(--bg);
      border: 1.5px solid var(--border); color: var(--text);
      border-radius: var(--radius-sm); padding: 13px;
      font-size: 14px; font-weight: 600;
      cursor: pointer; font-family: 'Inter', sans-serif;
      margin-top: 10px; transition: all 0.2s;
    }
    .back-btn:hover { border-color: var(--green); color: var(--green); }

    /* TOAST */
    .toast {
      position: fixed; bottom: 24px; left: 50%;
      transform: translateX(-50%) translateY(80px);
      background: #1a1d23; color: #fff;
      padding: 12px 20px; border-radius: 10px;
      font-size: 13px; font-weight: 600;
      transition: transform 0.3s; z-index: 999;
      white-space: nowrap;
      box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }
    .toast.show { transform: translateX(-50%) translateY(0); }

    /* MODAL OVERLAY */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.45);
      display: flex; align-items: flex-end; justify-content: center;
      z-index: 100; opacity: 0; pointer-events: none;
      transition: opacity 0.3s;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal {
      width: 100%; max-width: 480px;
      background: var(--white);
      border-radius: 20px 20px 0 0;
      padding: 28px 20px 40px;
      transform: translateY(100%);
      transition: transform 0.35s cubic-bezier(.4,0,.2,1);
    }
    .modal-overlay.open .modal { transform: translateY(0); }
    .modal-title { font-size: 14px; color: var(--muted); text-align: center; margin-bottom: 20px; line-height: 1.5; }
  </style>
</head>
<body>

  <!-- HEADER -->
  <div class="header">
    <div class="header-logo">
      <div class="header-logo-box" style="background:transparent;width:160px;height:42px;">
        <img src="data:image/jpeg;base64,
        
